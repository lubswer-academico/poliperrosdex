  "cards": [
    {
      "dot": "cyan",
      "title": "Arquitectura MVVM Estricta",
      "items": [
        "Las rutas en src/app solo reexportan pantallas sin lógica de negocio",
        "Las Vistas nunca importan repositorios ni tocan Supabase directamente (controlado por ESLint)",
        "Los ViewModels preparan el estado para la UI y exponen comandos asíncronos"
      ]
    },
    {
      "dot": "emerald",
      "title": "Patrón Repository y Dominio",
      "items": [
        "Repositorios mapean respuestas de PostgREST a modelos de dominio inmutables (Perro, Avistamiento)",
        "registrarCaptura coordina subida a Storage e inserción SQL con cancelación por AbortSignal",
        "EntrenadorRepository encapsula la persistencia del apodo en apodo.txt"
      ]
    },
    {
      "dot": "rose",
      "title": "Hardware y Seguridad Supabase",
      "items": [
        "Acelerómetro detecta caída libre (<0.55g) seguida de impacto (>1.8g) para descartar capturas",
        "Políticas RLS en Postgres restringen lecturas e inserciones públicas anónimas",
        "El WebView con Leaflet carga mosaicos de OpenStreetMap con baseUrl configurada"
      ]
    }
